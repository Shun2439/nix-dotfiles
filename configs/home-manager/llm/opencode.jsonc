{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "llama-cpp": {
      "name": "llama.cpp (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        // Local inference is slow; never time out a long generation.
        "timeout": false
      },
      "models": {
        "qwen3-4b": {
          "name": "Qwen3 4B Instruct 2507 (local)",
          "modelID": "qwen3-4b",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  }
}
